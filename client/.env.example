# ------------------------------------------------------------------ the API
#
# The recommended setup on Vercel is these two together:
#
#   NEXT_PUBLIC_API_URL=/api
#   API_ORIGIN=https://your-api.vercel.app
#
# NEXT_PUBLIC_API_URL is what the browser calls. Leaving it root-relative means
# the shop and its API share an origin, so the session cookie is first-party —
# which matters because Safari blocks third-party cookies outright and Chrome
# is removing them. Without this, signing in would fail for a real share of
# visitors and the error would say nothing useful.
#
# API_ORIGIN is where that /api path is proxied to (see the rewrites in
# next.config.ts) and where server-rendered pages fetch the catalogue from. It
# is read at BUILD time, so it must be set on the Vercel project before the
# build runs. No trailing slash.
NEXT_PUBLIC_API_URL=/api
API_ORIGIN=https://your-api.vercel.app

# Running the two halves locally on separate ports instead? Point the browser
# straight at the API and leave API_ORIGIN unset — the proxy then does nothing.
#   NEXT_PUBLIC_API_URL=http://localhost:3001/api
#
# That form is for local development only. In production it makes the session a
# third-party cookie (Safari blocks those, Chrome is removing them), adds a CORS
# preflight to every call, and takes proxy.ts out of the path so the API can no
# longer see who is calling it. Verify with `curl https://<host>/api/health`:
# JSON means the proxy is wired, an HTML page means API_ORIGIN is missing.

# --------------------------------------------------------------- the address
# Where this deployment answers, with no trailing slash. Every canonical link,
# hreflang tag, Open Graph URL and sitemap entry is built from it, so a wrong
# value points search engines at somewhere that is not the shop.
#
# Leave it empty on Vercel until there is a custom domain: the project's stable
# production .vercel.app domain is used automatically, and a preview deployment
# describes itself. Set it the moment a real domain exists.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------ rate limiting
# The same value as INTERNAL_PROXY_SECRET on the API project — they must match
# exactly. proxy.ts uses it to vouch for the visitor's IP address on every
# request it forwards to /api, which is what lets the API rate-limit the actual
# abuser rather than the storefront. It is server-only: no NEXT_PUBLIC_ prefix,
# so it is never sent to a browser.
INTERNAL_PROXY_SECRET=

# ------------------------------------------------------------------ firebase
# Unused by the running app: staff sign in against the Express API with their
# Haven account, and the role on that account is what opens a console. These
# stay for the dormant lib/firebase.ts helper and can be left empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
