# ---------------------------------------------------------------- runtime
# "dev" prints stack traces in error responses and keeps the session cookie on
# SameSite=Lax. Anything else — use "prod" — hides internals and switches the
# cookie to SameSite=None; Secure, which is what a browser requires when the
# storefront and the API sit on different hosts. Set this to prod on Vercel.
NODE_ENV=prod

# Local only. Vercel provides the port itself and ignores this.
PORT=3001

# ------------------------------------------------------------- database
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/e-commerce?appName=Cluster0

# Local escape hatch: some networks cannot resolve the Atlas SRV record through
# their own resolver. Ignored on Vercel. Set to an empty value to opt out.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# ------------------------------------------------------------- the client
# Where the storefront is served from — used for the links in emails, for the
# redirect after a Google sign-in, and as the CORS allow-list. Takes a
# comma-separated list so a Vercel domain and a custom domain can both be live.
# No trailing slash.
CLIENT_URL=https://your-storefront.vercel.app

# Preview deployments get a new hostname on every push, so they cannot be
# listed in CLIENT_URL. Turning this on allows origins matching the storefront
# project's own name — haven-<anything>.vercel.app — and nothing else. Leave it
# off if only the production domain should ever reach this deployment.
ALLOW_VERCEL_PREVIEWS=true

# Only needed if the storefront lives on a custom domain, leaving no Vercel
# project name for the line above to read out of CLIENT_URL. Set it to the
# storefront project's name on Vercel.
# PREVIEW_URL_PREFIX=haven

# -------------------------------------------------------------- sessions
# Any long random string. Changing it signs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-32-random-bytes
JWT_EXPIRES=3d

# --------------------------------------------------------- google sign-in
# The callback must point at the STOREFRONT domain, not at this API: the
# storefront proxies /api through to here, so the session cookie is set on the
# origin the shopper is actually browsing. Add the same URL to
# Google Cloud Console > Credentials > Authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-storefront.vercel.app/api/auth/google/callback

# ----------------------------------------------------------------- email
# Without a key, emails are printed to the function logs instead of being sent,
# so sign-up links can still be followed while you are setting things up.
RESEND_API_KEY=
EMAIL_FROM=Haven <onboarding@resend.dev>

# --------------------------------------------------------------- payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- uploads
# Uploaded photography is stored in MongoDB and served from /api/media/<id>.
# The URLs saved on a product are root-relative, so they follow whatever domain
# the shop is on. Set this only if images must be served from somewhere else —
# it is prefixed to every stored URL. No trailing slash.
# MEDIA_BASE_URL=https://your-api.vercel.app
